@model ViewTask.Models.Product

<h2>Create Product</h2>

<form method="post">
    <div asp-validation-summary="ModelOnly" style="color: red;"></div>

    <div style="margin-bottom: 10px;">
        <label>Name:</label><br />
        <input type="text" asp-for="Name" />
        <span asp-validation-for="Name" style="color: red;"></span>
    </div>
    
    <div style="margin-bottom: 10px;">
        <label>Description:</label><br />
        <input type="text" asp-for="Description" />
        <span asp-validation-for="Description" style="color: red;"></span>
    </div>

    <div style="margin-bottom: 10px;">
        <label>Type:</label><br />
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<ViewTask.Models.ProductType>()"></select>
    </div>

    <div style="margin-bottom: 10px;">
        <label>Price:</label><br />
        <input type="number" step="0.01" asp-for="Price" />
        <span asp-validation-for="Price" style="color: red;"></span>
    </div>
    
    <button type="submit">Save</button>
    <a href="/products">Cancel</a>
</form>