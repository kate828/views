@model IEnumerable<ViewTask.Models.Product>

<h2>Products List</h2>

<form method="get" action="/products" style="margin-bottom: 20px;">
    <input type="text" name="name" placeholder="Filter by name" value="@Context.Request.Query["name"]" />
    <input type="number" step="0.01" name="minPrice" placeholder="Min price" value="@Context.Request.Query["minPrice"]" />
    <input type="number" step="0.01" name="maxPrice" placeholder="Max price" value="@Context.Request.Query["maxPrice"]" />
    <button type="submit">Filter</button>
    <a href="/products">Reset</a>
</form>

<p>
    <a href="/products/create">+ Create New Product</a>
</p>

<table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>
                    <a href="/products/@item.Id">View</a> | 
                    <a href="/products/edit/@item.Id">Edit</a> | 
                    <a href="/products/delete/@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>