@model IList<ViewTask.Models.Product>

<h2>Edit Prices for: @ViewBag.SelectedType</h2>

<form method="post" action="/products/bulkedit/@ViewBag.SelectedType">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
            <input type="hidden" asp-for="@Model[i].Id" />
            <input type="hidden" asp-for="@Model[i].Type" />
            
            <label>ID: @Model[i].Id</label><br/>
            
            <label>Name:</label>
            <input type="text" asp-for="@Model[i].Name" readonly style="background-color: #eee;" />
            <br/>

            <label>Price (editable):</label>
            <input type="number" step="0.01" asp-for="@Model[i].Price" />
            <span asp-validation-for="@Model[i].Price" style="color: red;"></span>
        </div>
    }

    @if (Model.Count == 0)
    {
        <p>No products in this category.</p>
    }
    else
    {
        <button type="submit">Save All Prices</button>
    }
    <a href="/products">Cancel</a>
</form>